{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zeropress.dev/schemas/preview-data.v0.1.schema.json",
  "title": "ZeroPress Theme Preview Data",
  "type": "object",
  "additionalProperties": true,
  "required": ["site"],
  "properties": {
    "site": {
      "type": "object",
      "required": ["title", "description", "url", "language"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "url": { "type": "string", "format": "uri" },
        "language": { "type": "string", "minLength": 2 }
      },
      "additionalProperties": true
    },
    "posts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["title", "slug", "html"],
        "properties": {
          "title": { "type": "string", "minLength": 1 },
          "slug": { "type": "string", "minLength": 1 },
          "html": { "type": "string" },
          "excerpt": { "type": "string" },
          "published_at": { "type": "string" },
          "updated_at": { "type": "string" },
          "author_name": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "pages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["title", "slug", "html"],
        "properties": {
          "title": { "type": "string", "minLength": 1 },
          "slug": { "type": "string", "minLength": 1 },
          "html": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "slug"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "slug": { "type": "string", "minLength": 1 },
          "postCount": { "type": "integer", "minimum": 0 }
        },
        "additionalProperties": true
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "slug"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "slug": { "type": "string", "minLength": 1 },
          "postCount": { "type": "integer", "minimum": 0 }
        },
        "additionalProperties": true
      }
    }
  }
}
