{
  "$schema": "https://schemas.zeropress.dev/build-pages-config/v0.1/schema.json",
  "version": "0.1",
  "site": {
    "title": "ZeroPress Public Docs",
    "description": "ZeroPress theme authoring guides, runtime documentation, and CLI guides.",
    "url": "https://zeropress.dev",
    "footer": {
      "copyright_text": "ZeroPress Public Docs"
    },
    "logo": {
      "src": "/favicon_padding.svg",
      "alt": "ZeroPress Logo"
    }
  },
  "menus": {
    "primary": {
      "name": "Primary Menu",
      "items": [
        { "title": "Getting Started", "url": "/getting-started/" },
        { "title": "Theme Authoring", "url": "/theme-authoring/" },
        { "title": "Reference", "url": "/reference/" },
        { "title": "CLI Tools", "url": "/cli/" }
      ]
    },
    "footer": {
      "name": "Footer Menu",
      "items": [
        { "title": "Schemas", "url": "https://schemas.zeropress.dev/", "target": "_blank" },
        { "title": "GitHub", "url": "https://github.com/zeropress-app", "target": "_blank" },
        { "title": "npm", "url": "https://www.npmjs.com/org/zeropress", "target": "_blank" },
        { "title": "License", "url": "/license/" }
      ]
    }
  },
  "collections": {
    "guides": {
      "title": "Guides",
      "items": [
        "getting-started/index.md",
        "theme-authoring/index.md",
        "cli/index.md",
        "packages/index.md"
      ]
    },
    "reference": {
      "title": "Reference",
      "items": [
        "reference/index.md",
        "reference/preview-data/index.md",
        "reference/theme-runtime/index.md",
        "static-search/index.md"
      ]
    }
  }
}
