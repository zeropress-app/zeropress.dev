{
  "$schema": "https://schemas.zeropress.dev/build-pages-config/v1.0/schema.json",
  "version": "1.0",
  "site": {
    "title": "ZeroPress Docs",
    "description": "ZeroPress theme authoring guides, runtime documentation, and CLI guides.",
    "url": "https://zeropress.dev",
    "footer": {
      "copyright_text": "© 2026 ZeroPress"
    },
    "logo": {
      "src": "/favicon_padding.svg",
      "alt": "ZeroPress Logo"
    }
  },
  "markdown": {
    "updated_at": "git"
  },
  "custom_html": {
    "body_end": {
      "file": ".zeropress/body_end.html"
    }
  },
  "menus": {
    "primary": {
      "name": "Primary Menu",
      "items": [
        {
          "title": "GET STARTED",
          "url": "/",
          "children": [
            { "title": "Overview", "url": "/" },
            { "title": "Getting Started", "url": "/getting-started/" },
            { "title": "Package Quick Starts", "url": "/packages/" }
          ]
        },
        {
          "title": "GUIDES",
          "url": "/guides/",
          "children": [
            { "title": "Guides Overview", "url": "/guides/" },
            { "title": "Theme Authoring", "url": "/guides/theme-authoring/" },
            { "title": "CLI Tools", "url": "/guides/cli/" },
            { "title": "Static Search", "url": "/guides/static-search/" }
          ]
        },
        {
          "title": "REFERENCE",
          "url": "/reference/",
          "children": [
            { "title": "Reference Hub", "url": "/reference/" },
            { "title": "Preview Data Reference", "url": "/reference/preview-data/" },
            {
              "title": "Preview Data Specs",
              "url": "/reference/preview-data/specs/",
              "children": [
                {
                  "title": "Preview Data v0.7",
                  "url": "/reference/preview-data/specs/v0.7/"
                },
                {
                  "title": "Preview Data v0.6",
                  "url": "/reference/preview-data/specs/v0.6/"
                }
              ]
            },
            { "title": "Theme Runtime Reference", "url": "/reference/theme-runtime/" },
            { "title": "Theme Package Limits", "url": "/reference/theme-runtime/package-limits/" },
            {
              "title": "Theme Runtime Specs",
              "url": "/reference/theme-runtime/specs/",
              "children": [
                {
                  "title": "Theme Runtime v0.7",
                  "url": "/reference/theme-runtime/specs/v0.7/"
                },
                {
                  "title": "Theme Runtime v0.6",
                  "url": "/reference/theme-runtime/specs/v0.6/"
                }
              ]
            }
          ]
        }
      ]
    },
    "footer": {
      "name": "Footer Menu",
      "items": [
        { "title": "Schemas", "url": "https://schemas.zeropress.dev/", "target": "_blank" },
        { "title": "GitHub", "url": "https://github.com/zeropress-app", "target": "_blank" },
        { "title": "npm", "url": "https://www.npmjs.com/org/zeropress", "target": "_blank" },
        { "title": "License", "url": "/license/" }
      ]
    }
  },
  "collections": {
    "get_started": {
      "title": "Get Started",
      "items": [
        "index.md",
        "getting-started/index.md",
        "packages/index.md"
      ]
    },
    "guides": {
      "title": "Guides",
      "items": [
        "guides/index.md",
        "guides/theme-authoring/index.md",
        "guides/cli/index.md",
        "guides/static-search/index.md"
      ]
    },
    "reference": {
      "title": "Reference",
      "items": [
        "reference/index.md",
        "reference/preview-data/index.md",
        "reference/preview-data/specs/index.md",
        "reference/preview-data/specs/v0.7/index.md",
        "reference/preview-data/specs/v0.6/index.md",
        "reference/theme-runtime/index.md",
        "reference/theme-runtime/package-limits/index.md",
        "reference/theme-runtime/specs/index.md",
        "reference/theme-runtime/specs/v0.7/index.md",
        "reference/theme-runtime/specs/v0.6/index.md"
